# Copy this file to `.env` in the same directory before running `docker compose up -d`.
# Compose reads `.env` automatically; it is never baked into the image.

POSTGRES_DB=imdb
POSTGRES_USER=imdb
POSTGRES_PASSWORD=imdb_pass
POSTGRES_PORT=5432

# Consumed by the host-side Python producer/consumer (scripts/common.py).
PGHOST=localhost
PGPORT=5432
PGDATABASE=imdb
PGUSER=imdb
PGPASSWORD=imdb_pass
